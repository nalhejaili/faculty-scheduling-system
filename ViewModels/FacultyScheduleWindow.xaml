<Window x:Class="MiniTrainerScheduler.Views.FacultyScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:MiniTrainerScheduler.Views.Controls"
        mc:Ignorable="d"
        Title="Faculty Member Timetable"
        Height="700"
        Width="1100"
        FlowDirection="LeftToRight"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">

                <TextBlock Text="Faculty Member:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <ComboBox Width="250"
                          ItemsSource="{Binding Faculties}"
                          SelectedItem="{Binding SelectedFaculty}"
                          DisplayMemberPath="Name"
                          Margin="0,0,15,0"/>

                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,15,0">
                    <Run Text="Total: "/>
                    <Run Text="{Binding FacultyTotalHours}"/>
                    <Run Text=" hrs"/>
                </TextBlock>

                <Button Content="Refresh"
                        Width="90"
                        Margin="0,0,5,0"
                        Click="RefreshBtn_Click"/>

                <Button Content="Export CSV"
                        Width="110"
                        Margin="0,0,5,0"
                        Click="ExportCsvBtn_Click"/>

                <Button Content="Print"
                        Width="90"
                        Click="PrintBtn_Click"/>
            </StackPanel>
        </DockPanel>

        
        
        <Border Grid.Row="1"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,0,0,10">
            <StackPanel Orientation="Vertical"
                        Margin="0">

                <TextBlock Text="Manage Faculty Member Timetable"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,4">

                    
                    <TextBlock Text="Department:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <ComboBox Width="160"
                              ItemsSource="{Binding Departments}"
                              SelectedItem="{Binding SelectedDepartment}"
                              DisplayMemberPath="Name"
                              Margin="0,0,10,0"/>

                    
                    <TextBlock Text="Level:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <ComboBox Width="80"
                              ItemsSource="{Binding Levels}"
                          SelectedValuePath="."
                          SelectedValue="{Binding SelectedLevel}"
                              Margin="0,0,10,0"/>

                    
                    <TextBlock Text="Course:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <ComboBox Width="220"
                              ItemsSource="{Binding Courses}"
                              SelectedItem="{Binding SelectedCourse}"
                              DisplayMemberPath="Name"
                              Margin="0,0,10,0"/>

                    
                    <TextBlock Text="Class Type:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,0,10,0">
                        <Button Content="Laboratory"
                                Tag="LAB"
                                Padding="12,4"
                                Margin="0,0,6,0"
                                IsEnabled="{Binding HasPracticalPart}"
                                Click="SelectKind_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding SelectedKind}" Value="LAB">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Lecture"
                                Tag="THEORY"
                                Padding="12,4"
                                IsEnabled="{Binding HasTheoryPart}"
                                Click="SelectKind_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding SelectedKind}" Value="THEORY">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    
                    <TextBlock Text="Section:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBox Width="60"
                             Text="{Binding SelectedSectionIndex, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0"/>

                    
                    <TextBlock Text="Time Slot:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               Visibility="Collapsed"/>

                    <ComboBox Width="200"
                              ItemsSource="{Binding Slots}"
                              SelectedItem="{Binding SelectedSlot}"
                              Margin="0,0,5,0"
                              Visibility="Collapsed"/>

                    
                    <Button Content="..."
                            Width="30"
                            Margin="0,0,10,0"
                            ToolTip="Select weekly class meeting times from the timetable grid"
                            Click="OpenSlotsPicker_Click"/>
                </StackPanel>

                
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    
                    <TextBlock Text="Release / Duty Note (Optional):"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBox Width="260"
                             Text="{Binding BlockReason}"
                             Margin="0,0,10,0"/>

                    
                    <Button Content="Add Faculty Duty Block"
                            Width="110"
                            Click="AddBlockWithPicker_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        
        <TabControl Grid.Row="2">

            
            <TabItem Header="Allocated Sessions">
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Margin="0,5,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Department"
                                            Binding="{Binding Department}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Course"
                                            Binding="{Binding Course}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Section"
                                            Binding="{Binding Section}"
                                            Width="60"/>
                        <DataGridTextColumn Header="Time Slot"
                                            Binding="{Binding Slot}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Weekly Hours"
                                            Binding="{Binding Hours}"
                                            Width="70"/>
                        <DataGridTextColumn Header="Class Type"
                                            Binding="{Binding Kind}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Room"
                                            Binding="{Binding Room}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="80"/>
                    </DataGrid.Columns>

                    
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete This Row"
                                      Command="{Binding DataContext.DeleteRowCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>

            
            <TabItem Header="Weekly Timetable">
                
                <Border x:Name="TemplateRoot"
                        BorderBrush="#707070"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,5,0,0">
                    
                    <v:GeneralScheduleGrid DataContext="{Binding GeneralProxy}"/>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
