<Window x:Class="MiniTrainerScheduler.Windows.MasterBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MiniTrainerScheduler.Views"
        Title="University Master Timetable"
        WindowStartupLocation="CenterOwner"
        Width="1100" Height="800"
        FlowDirection="LeftToRight"
        Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F8F9FB" Padding="8" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Print" Padding="16,6" Margin="6,0,0,0" Click="Print_Click"/>
                <Button Content="Close" Padding="16,6" Margin="6,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border Padding="8" Background="White">
                <views:MasterBoardView x:Name="MasterView"/>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
