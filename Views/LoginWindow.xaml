<Window x:Class="MiniTrainerScheduler.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In"
        Height="520"
        Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="LeftToRight"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="14,4"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" Text="Sign In" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="HintText" Text="Enter your credentials to continue." Margin="0,4,0,0" Foreground="Gray"/>
        </StackPanel>

        <Border Grid.Row="1" Padding="16" BorderBrush="#DDD" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scrollable content (fixes high-DPI clipping) -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Login mode -->
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Text="Username" Margin="0,0,0,6"/>
                            <TextBox x:Name="LoginUsernameBox"/>

                            <TextBlock Text="Password" Margin="0,12,0,6"/>
                            <PasswordBox x:Name="LoginPasswordBox"/>
                        </StackPanel>

                        <!-- First Admin mode -->
                        <StackPanel x:Name="FirstAdminPanel" Visibility="Collapsed">
                            <TextBlock Text="Username (Admin)" Margin="0,0,0,6"/>
                            <TextBox x:Name="AdminUsernameBox"/>

                            <TextBlock Text="Password" Margin="0,12,0,6"/>
                            <PasswordBox x:Name="AdminPasswordBox"/>

                            <TextBlock Text="Confirm Password" Margin="0,12,0,6"/>
                            <PasswordBox x:Name="AdminPasswordConfirmBox"/>

                            <TextBlock Text="Note: this account will be the first system administrator for the application." Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="PrimaryActionButton" Content="Sign In" Style="{StaticResource PrimaryButton}" Click="PrimaryActionButton_Click"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="DbPathText" FontSize="11" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Content="Network Settings" Margin="0,10,0,0" Padding="14,4"
                    HorizontalAlignment="Center" Click="OpenLanSettings_Click"/>
        </StackPanel>
    </Grid>
</Window>
