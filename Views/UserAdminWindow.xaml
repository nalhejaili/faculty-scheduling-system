<Window x:Class="MiniTrainerScheduler.Views.UserAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User and Access Management"
        Height="650" Width="980"
        FlowDirection="LeftToRight"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFBFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppTopBarBrush}"
                Padding="12"
                BorderBrush="{DynamicResource AppTopBarBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="User and Access Management"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock x:Name="DbPathText"
                               Foreground="#C7D2FE"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Click="Reload_Click" Background="#F3F4F6" BorderBrush="#D1D5DB"/>
                    <Button Content="Close" Click="Close_Click" Background="#F3F4F6" BorderBrush="#D1D5DB"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Create user panel -->
            <Border Background="White" Padding="12" CornerRadius="10"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Username" FontWeight="SemiBold"/>
                        <TextBox x:Name="UsernameBox" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Password" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Role" FontWeight="SemiBold"/>
                        <ComboBox x:Name="RoleBox" Margin="0,6,0,0" SelectionChanged="RoleBox_SelectionChanged">
                            <ComboBoxItem Content="System Administrator" Tag="Admin"/>
                            <ComboBoxItem Content="Academic Department Supervisor" Tag="Supervisor" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                        <TextBlock Text="Assigned Department" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DepartmentBox" Margin="0,6,0,0"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Create User" Click="Create_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Users list -->
            <Border Grid.Row="1" Background="White" Padding="12" CornerRadius="10"
                    BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Reset Password" Click="ResetPassword_Click"/>
                        <Button Content="Delete Account" Click="Delete_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="UsersGrid" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding RoleText}" Width="180"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="220"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
