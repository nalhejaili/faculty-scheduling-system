<Window x:Class="MiniTrainerScheduler.Views.ActivationPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Activation"
        Height="220"
        Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="LeftToRight"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0"
                   Text="Enter the license serial assigned to this device:"
                   FontSize="18"
                   Margin="0,0,0,10"/>

        
        <TextBox x:Name="SerialTextBox"
                 Grid.Row="1"
                 FontSize="16"
                 Margin="0,0,0,10"/>

        
        <StackPanel Grid.Row="2"
                    Orientation="Vertical">

            
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Left">
                <TextBlock Text="Device Identifier:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="MachineIdTextBlock"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="14"/>

                <Button Content="Copy"
                        Margin="10,0,0,0"
                        Padding="12,2"
                        Click="CopyMachineId_Click"/>
            </StackPanel>

            
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="Activate"
                        Width="120"
                        Margin="5"
                        Click="Activate_Click"/>
                <Button Content="Cancel"
                        Width="120"
                        Margin="5"
                        IsCancel="True"
                        Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
