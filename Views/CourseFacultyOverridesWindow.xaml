<Window x:Class="MiniTrainerScheduler.Views.CourseFacultyOverridesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Faculty Assignment Rules"
        Width="980" Height="680"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FB"
        FlowDirection="LeftToRight">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0E2A47" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Assign Faculty Members to Courses" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Margin="0,6,0,0"
                           Text="Assignment rules are stored in the database and loaded automatically when the application starts."
                           Foreground="#DDE7F2" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        
                        <GroupBox Header="Course" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                            
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Department" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="DeptMajorCombo" Height="32" HorizontalAlignment="Stretch"
                                              SelectionChanged="DeptMajorCombo_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="Specialization" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="DeptSpecialtyCombo" Height="32" HorizontalAlignment="Stretch"
                                              SelectionChanged="DeptSpecialtyCombo_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                    <TextBlock Text="Level" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CourseLevelCombo" Height="32" HorizontalAlignment="Stretch"
                                              SelectionChanged="CourseLevelCombo_SelectionChanged"/>
                                </StackPanel>

                                
                                <TextBox Grid.Row="3" x:Name="CourseFilterBox"
                                         Height="30" Margin="0,0,0,8"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Type to search for a course"/>

                                
                                <ComboBox Grid.Row="4" x:Name="CourseCombo"
                                          Height="32" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Courses}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedOverrideCourse, Mode=TwoWay}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Faculty Members (Multiple Selection Allowed)" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                            <StackPanel Margin="8">
                                <TextBox x:Name="FacultyFilterBox" Height="30" Margin="0,0,0,8"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Type to search for a faculty member"/>

                                <ListBox x:Name="FacultyList"
                                         Height="220"
                                         ItemsSource="{Binding Faculties}"
                                         DisplayMemberPath="Name"
                                         SelectionMode="Extended"/>
                            </StackPanel>
                        </GroupBox>

                        <CheckBox x:Name="ApplyAllSameNameChk"
                                  Content="Apply to all courses with the same name (all departments)"
                                  Margin="4,0,4,12"/>

                        <CheckBox x:Name="UseCourseCodeChk"
                                  Content="Match by course code (CourseCode)"
                                  Margin="4,0,4,6"/>

                        <CheckBox x:Name="CodeScopeAllDeptsChk"
                                  Content="By code: apply to all departments (global scope)"
                                  Margin="22,0,4,12"/>


                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <Button Content="Add Rule" Height="34" Padding="14,0" Margin="0,0,8,0"
                                    Click="AddOverrides_Click"/>
                            <Button Content="Delete Selected" Height="34" Padding="14,0"
                                    Command="{Binding RemoveCfoCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Current Assignment Rules" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CfoRows}"
                              SelectedItem="{Binding SelectedCfoRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mode" Binding="{Binding KindDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding CourseName}" Width="*"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding CourseCode}" Width="110"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDepartmentName}" Width="130"/>
                            <DataGridTextColumn Header="Faculty Member" Binding="{Binding FacultyName}" Width="*"/>
                            <DataGridTextColumn Header="CourseId" Binding="{Binding CourseId}" Width="90"/>
                            <DataGridTextColumn Header="FacultyId" Binding="{Binding FacultyId}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Margin="4,12,4,0" Foreground="#6B7280" FontSize="12"
                   Text="Note: the scheduler applies these assignment rules during timetable generation, and any conflict will be explained in the report."/>
    </Grid>

</Window>
