<Window x:Class="MiniTrainerScheduler.Views.DataAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Management"
        Height="720" Width="1100"
        FlowDirection="LeftToRight"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBFBFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
	    <!-- Header -->
	    <Border DockPanel.Dock="Top"
	            Background="{DynamicResource AppTopBarBrush}"
	            Padding="12"
	            BorderBrush="{DynamicResource AppTopBarBorderBrush}"
	            BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

	            <StackPanel>
	                <TextBlock Text="Data Management (SQLite)"
	                           FontSize="18"
	                           FontWeight="SemiBold"
	                           Foreground="White"/>
		            <TextBlock Text="Local SQLite Database"
		                       Foreground="White"
		                       Opacity="0.85"
		                       FontSize="12" Margin="0,4,0,0"/>
	            </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding ReloadCommand}"/>
                    <Button Content="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <TabControl Margin="0,12,0,0">
            <!-- Departments -->
            <TabItem Header="Departments">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Add" Command="{Binding AddDepartmentCommand}"/>
                        <Button Content="Delete" Command="{Binding DeleteDepartmentCommand}"/>
                        <Button Content="Save" Command="{Binding SaveDepartmentsCommand}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Departments}"
                              SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Department Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Faculties -->
            <TabItem Header="Faculty Members">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Add" Command="{Binding AddFacultyCommand}"/>
                        <Button Content="Delete" Command="{Binding DeleteFacultyCommand}"/>
                        <Button Content="Save" Click="SaveFaculties_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="FacultiesGrid" Grid.Row="1"
                              ItemsSource="{Binding Faculties}"
                              SelectedItem="{Binding SelectedFaculty, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Faculty Member Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                            <DataGridTemplateColumn Header="Department" Width="220">
    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <ComboBox ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsHitTestVisible="False"
                      Focusable="False"/>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>
    <DataGridTemplateColumn.CellEditingTemplate>
        <DataTemplate>
            <ComboBox ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
    </DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>

                            <DataGridCheckBoxColumn Header="General Studies" Binding="{Binding IsGeneralStudies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"
                                                 ElementStyle="{StaticResource AppDataGridCheckBoxStyle}"
                                                 EditingElementStyle="{StaticResource AppDataGridCheckBoxStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Courses -->
            <TabItem Header="Courses">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Add" Command="{Binding AddCourseCommand}"/>
                        <Button Content="Delete" Command="{Binding DeleteCourseCommand}"/>
                        <Button Content="Save" Command="{Binding SaveCoursesCommand}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="Note: you can enter the course code and it will be saved in the database."
                               Foreground="#6B7280"
                               FontSize="12"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>


                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Courses}"
                              SelectedItem="{Binding SelectedCourse, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Course Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Course Code" Binding="{Binding CourseCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>


                            <DataGridTemplateColumn Header="Department" Width="220">
    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <ComboBox ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsHitTestVisible="False"
                      Focusable="False"/>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>
    <DataGridTemplateColumn.CellEditingTemplate>
        <DataTemplate>
            <ComboBox ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate>
    </DataGridTemplateColumn.CellEditingTemplate>
</DataGridTemplateColumn>

                            <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="Hours / Week" Binding="{Binding HoursPerWeek, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridCheckBoxColumn Header="General" Binding="{Binding IsGeneralCourse, Mode=TwoWay}" Width="90"
                                                 ElementStyle="{StaticResource AppDataGridCheckBoxStyle}"
                                                 EditingElementStyle="{StaticResource AppDataGridCheckBoxStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            
            <TabItem Header="Course Code Mapping">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,10">
                        <Run Text="This tab links the course code coming from the expected registration report to the internal course ID used by the application."/>
                        <LineBreak/>
                        <Run Text="Note: when the report is imported, unknown codes are added here automatically, then you only need to select the matching course once."/>
                    </TextBlock>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <Button Content="Delete Row" Command="{Binding DeleteCourseCodeMapCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear Mapping" Command="{Binding ClearCourseCodeMapCourseCommand}" Margin="0,0,8,0"/>
                        <Button Content="Save" Command="{Binding SaveCourseCodeMapsCommand}"/>
                    </StackPanel>

                    <!-- Filters to narrow the internal course list when mapping many rows -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="Department:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="220"
                                 ItemsSource="{Binding DepartmentBaseOptions}"
                                 SelectedItem="{Binding SelectedDepartmentBase, Mode=TwoWay}"/>

                        <TextBlock Text="Specialization:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <ComboBox Width="220"
                                 IsEnabled="{Binding IsSpecialtyEnabled}"
                                 ItemsSource="{Binding SpecialtyOptions}"
                                 SelectedItem="{Binding SelectedSpecialty, Mode=TwoWay}"/>

                        <TextBlock Text="Level:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <ComboBox Width="110"
                                 ItemsSource="{Binding LevelOptions}"
                                 SelectedItem="{Binding SelectedLevelOption, Mode=TwoWay}"/>

                        <Button Content="Clear Filters" Command="{Binding ClearCourseFiltersCommand}" Margin="14,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding CourseCodeMaps}"
                              SelectedItem="{Binding SelectedCourseCodeMap}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              BorderThickness="1"
                              BorderBrush="#CCC"
                              FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Course Code" Binding="{Binding CourseCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            <DataGridTextColumn Header="Course Name (from report)" Binding="{Binding CourseName}" Width="*" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Course in Application" Width="320">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.FilteredCourseOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding CourseId, Mode=TwoWay}"
                                                  IsHitTestVisible="False"
                                                  Focusable="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.FilteredCourseOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding CourseId, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="ID" Binding="{Binding CourseId}" Width="90" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>


<!-- Students -->
<TabItem Header="Students">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,8">
            <Run Text="Manual and CSV-based student intake are supported here."/>
            <LineBreak/>
            <Run Text="Add, edit, and save student profiles, then record each student&#39;s study plan for the upcoming term."/>
            <LineBreak/>
            <Run Text="For automated intake, import a CSV file that includes student details and, optionally, course registrations for the term."/>
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Add Student" Command="{Binding AddStudentCommand}"/>
            <Button Content="Delete Student" Command="{Binding DeleteStudentCommand}"/>
            <Button Content="Save Students" Click="SaveStudents_Click"/>
            <Button Content="Import CSV" Command="{Binding ImportStudentsCsvCommand}"/>
            <Button Content="Download Template" Command="{Binding ExportStudentImportTemplateCommand}"/>
        </StackPanel>

        <DataGrid x:Name="StudentsGrid" Grid.Row="2"
                  ItemsSource="{Binding Students}"
                  SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="#CCC"
                  FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Student Number" Binding="{Binding StudentNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                <DataGridTextColumn Header="Student Name" Binding="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                <DataGridTemplateColumn Header="Department" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsHitTestVisible="False"
                                      Focusable="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Academic Level" Binding="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" FontSize="14" Margin="0,12,0,6" Text="Smart Academic Registration (Upcoming Term)"/>

        <Border Grid.Row="4" BorderBrush="#D0D7DE" BorderThickness="1" Background="#F6F8FA" Padding="10" Margin="0,0,0,8">
            <TextBlock Text="{Binding SelectedStudentRegistrationSummary}" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Add Course" Command="{Binding AddStudentPlanCommand}"/>
            <Button Content="Remove Course" Command="{Binding DeleteStudentPlanCommand}"/>
            <Button Content="Validate Registration" Command="{Binding ValidateStudentRegistrationCommand}"/>
            <Button Content="Save Study Plan" Click="SaveStudentPlans_Click"/>
        </StackPanel>

        <DataGrid x:Name="StudentPlansGrid" Grid.Row="6"
                  ItemsSource="{Binding SelectedStudentPlans}"
                  SelectedItem="{Binding SelectedStudentPlan, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="#CCC"
                  FontSize="14">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Course" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.StudentPlanCourseOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding CourseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsHitTestVisible="False"
                                      Focusable="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.StudentPlanCourseOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding CourseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridCheckBoxColumn Header="Repeat" Binding="{Binding IsRepeat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                     ElementStyle="{StaticResource AppDataGridCheckBoxStyle}"
                                     EditingElementStyle="{StaticResource AppDataGridCheckBoxStyle}"/>
                <DataGridTextColumn Header="Academic Term (Optional)" Binding="{Binding TermKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</TabItem>
<!-- Maintenance -->

<TabItem Header="Rooms">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Add" Command="{Binding AddRoomCommand}"/>
            <Button Content="Delete" Command="{Binding DeleteRoomCommand}"/>
            <Button Content="Save" Command="{Binding SaveRoomsCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rooms}"
                  SelectedItem="{Binding SelectedRoom}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="#CCC"
                  FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                <DataGridTextColumn Header="Room Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                <DataGridTemplateColumn Header="Department" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsHitTestVisible="False"
                                Focusable="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedValue="{Binding DepartmentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</TabItem>

            <!-- Backup / Restore -->
            <TabItem Header="Backup / Restore">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Backup / Restore"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Create Backup"
                                Height="60"
                                Margin="0,0,10,0"
                                Command="{Binding BackupDatabaseCommand}"/>

                        <Button Grid.Column="1"
                                Content="Restore"
                                Height="60"
                                Margin="10,0,10,0"
                                Command="{Binding RestoreDatabaseCommand}"/>

                        <Button Grid.Column="2"
                                Content="Open Data Folder"
                                Height="60"
                                Margin="10,0,0,0"
                                Command="{Binding OpenDataFolderCommand}"/>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Note: when a restore is prepared, the application will close and apply it on the next launch."
                               FontSize="16"
                               Foreground="#666"/>
                </Grid>
            </TabItem>

            <TabItem Header="Legacy Data Maintenance">
    <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Diagnose, repair, and clean legacy records (Assignments/Blocks) that may cause gaps or prevent deletion. The Revision value will also be updated so client devices refresh automatically."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Opacity="0.85"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Diagnose" Command="{Binding DiagnoseLegacyCommand}"/>
            <Button Content="Run Maintenance" Command="{Binding RunLegacyMaintenanceCommand}"/>
            <Button Content="Copy Report" Command="{Binding CopyLegacyReportCommand}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="10">
            <TextBox Text="{Binding LegacyMaintenanceReport, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="13"/>
        </Border>
    </Grid>
</TabItem>

        </TabControl>
    </DockPanel>
</Window>
