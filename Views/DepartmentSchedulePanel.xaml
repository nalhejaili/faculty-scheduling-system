<UserControl x:Class="MiniTrainerScheduler.Views.DepartmentSchedulePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="clr-namespace:MiniTrainerScheduler.Views.Controls"
             mc:Ignorable="d"
             FlowDirection="LeftToRight">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            
            <RowDefinition Height="Auto"/>
            
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                <TextBlock Text="Department:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <ComboBox Width="180"
                          ItemsSource="{Binding Departments}"
                          SelectedItem="{Binding SelectedDepartment}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding CanSelectDepartment}"
                          Margin="0,0,15,0"/>

                <TextBlock Text="Level:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <ComboBox Width="80"
                          ItemsSource="{Binding Levels}"
                          SelectedValuePath="."
                          SelectedValue="{Binding SelectedLevel}"
                          Margin="0,0,15,0"/>

                
                <TextBlock Text="Total Hours:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBlock Text="{Binding DepartmentTotalHours, StringFormat={}{0} hrs}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,15,0"/>

                <Button Content="Refresh"
                        Width="90"
                        Margin="0,0,5,0"
                        Click="RefreshBtn_Click"/>

                <Button Content="Print"
                        Width="90"
                        Click="PrintBtn_Click"/>
            </StackPanel>
        </DockPanel>

        
        <TabControl Grid.Row="1">

            
            <TabItem Header="Allocated Sessions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="RowsGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Course"     Binding="{Binding Course}"     Width="2*"/>
                            <DataGridTextColumn Header="Section"     Binding="{Binding Section}"    Width="70"/>
                            <DataGridTextColumn Header="Faculty Member"     Binding="{Binding Faculty}"    Width="*"/>
                            <DataGridTextColumn Header="Time Slot"     Binding="{Binding Slot}"       Width="*"/>
                            <DataGridTextColumn Header="Room"     Binding="{Binding Room}"       Width="*"/>
                            <DataGridTextColumn Header="Weekly Hours"    Binding="{Binding Hours}"      Width="70"/>
                            <DataGridTextColumn Header="Status"     Binding="{Binding Status}"     Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0">
                        <TextBlock Text="Scheduled Entries:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Rows.Count}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            
            <TabItem Header="Weekly Timetable">
                
                <Border x:Name="TemplateRoot"
                        BorderBrush="#707070"
                        BorderThickness="1"
                        Padding="8"
                        Margin="0,5,0,0">
                    
                    <v:GeneralScheduleGrid DataContext="{Binding GeneralProxy}"/>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
